# Formspree form ID — create a form at https://formspree.io and add recipient email(s)
# in the Formspree dashboard (supports multiple addresses on paid plans, or use
# email forwarding from a single inbox).
FORMSPREE_FORM_ID=your_form_id_here

# Second-opinion landing page form (name, email, website URL, message)
FORMSPREE_FORM_ID_SECOND_OPINION=your_second_opinion_form_id_here

# Canonical site URL for JSON-LD schema (no trailing slash)
SITE_URL=https://nordicgiantdigital.com
